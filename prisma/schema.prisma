generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  attributes     Json
  description    String
  seoTitle       String
  seoDescription String
  status         String   @default("draft")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
